{
  "name": "sound-rekorder",
  "productName": "Sound Rekorder",
  "version": "1.0.0",
  "description": "Nimmt den Ton vom PC auf, ohne Video",
  "main": "main.js",
  "scripts": { "start": "electron .", "dist": "electron-builder --win --publish never" },
  "build": {
    "appId": "de.soundrekorder.app",
    "productName": "Sound Rekorder",
    "files": ["main.js", "preload.js", "index.html", "icon.png"],
    "win": { "target": ["nsis", "portable"], "icon": "icon.png" }
  },
  "devDependencies": { "electron": "33.2.1", "electron-builder": "25.1.8" }
}
